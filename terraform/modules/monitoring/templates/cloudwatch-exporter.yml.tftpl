# YACE (yet-another-cloudwatch-exporter) — AWS CloudWatch 지표를 Prometheus 로 노출.
# EC2/RDS/ALB 등 AWS 관리 지표(호스트 CPU·메모리·연결수 등)를 태그 발견으로 수집.
# 메트릭 이름: aws_ec2_cpuutilization_average 형태. 노출 포트 5000(/metrics).
apiVersion: v1alpha1
sts-region: ${region}

discovery:
  exportedTagsOnMetrics:
    AWS/EC2:
      - Name
    AWS/RDS:
      - Name
    AWS/SQS:
      - Name
    AWS/ES:
      - Name
    AWS/ElastiCache:
      - Name
    AWS/DocDB:
      - Name
  jobs:
    - type: AWS/EC2
      regions: [${region}]
      period: 300
      length: 300
      metrics:
        - name: CPUUtilization
          statistics: [Average]
        - name: NetworkIn
          statistics: [Average]
        - name: NetworkOut
          statistics: [Average]
        - name: StatusCheckFailed
          statistics: [Maximum]

    - type: AWS/RDS
      regions: [${region}]
      period: 300
      length: 300
      metrics:
        - name: CPUUtilization
          statistics: [Average]
        - name: FreeableMemory
          statistics: [Average]
        - name: DatabaseConnections
          statistics: [Average]
        - name: FreeStorageSpace
          statistics: [Average]

    - type: AWS/ApplicationELB
      regions: [${region}]
      period: 300
      length: 300
      metrics:
        - name: RequestCount
          statistics: [Sum]
        - name: TargetResponseTime
          statistics: [Average]
        - name: HTTPCode_Target_5XX_Count
          statistics: [Sum]
        - name: HTTPCode_Target_4XX_Count
          statistics: [Sum]

    # 폴백 이벤트·크롤링 결과 큐(메인+DLQ, prod/dev). 이름·태그 필터 없이 리전 내 SQS 를 발견한다.
    - type: AWS/SQS
      regions: [${region}]
      period: 300
      length: 300
      metrics:
        - name: ApproximateNumberOfMessagesVisible
          statistics: [Average]
        - name: ApproximateAgeOfOldestMessage
          statistics: [Maximum]
        - name: NumberOfMessagesSent
          statistics: [Sum]
        - name: NumberOfMessagesDeleted
          statistics: [Sum]

    # OpenSearch(chilsami-search) — 노드 수, 문서 수, 클러스터 상태로 노드 장애와 인덱스 유실을 알린다
    # (2026-10-20, 21 단일 노드 교체로 유실 → 2노드로 전환, SCRUM-672, SCRUM-675).
    - type: AWS/ES
      regions: [${region}]
      period: 300
      length: 300
      metrics:
        - name: ClusterStatus.green
          statistics: [Maximum]
        - name: ClusterStatus.yellow
          statistics: [Maximum]
        - name: ClusterStatus.red
          statistics: [Maximum]
        - name: Nodes
          statistics: [Minimum]
        - name: SearchableDocuments
          statistics: [Maximum]
        - name: CPUUtilization
          statistics: [Maximum]
        - name: JVMMemoryPressure
          statistics: [Maximum]
        - name: FreeStorageSpace
          statistics: [Minimum]
        - name: ClusterIndexWritesBlocked
          statistics: [Maximum]
        - name: AutomatedSnapshotFailure
          statistics: [Maximum]

    # 채팅 팬아웃 Redis(Valkey). Pub/Sub 구독이 조용히 끊기는 건 앱 지표로 보지만(BackEnd),
    # 노드 자원·연결·지표 누락은 인프라 차원에서도 감시. 노드 장애 시 지표가 끊기므로 누락=경보로 쓴다.
    - type: AWS/ElastiCache
      regions: [${region}]
      period: 300
      length: 300
      metrics:
        - name: EngineCPUUtilization
          statistics: [Average]
        - name: DatabaseMemoryUsagePercentage
          statistics: [Average]
        - name: CurrConnections
          statistics: [Average]
        - name: Evictions
          statistics: [Sum]
        - name: NewConnections
          statistics: [Sum]

    # DocumentDB(채팅 메시지 저장소) — CPU/연결/메모리/스토리지 감시. 지표 끊김 = 인스턴스 장애 신호.
    - type: AWS/DocDB
      regions: [${region}]
      period: 300
      length: 300
      metrics:
        - name: CPUUtilization
          statistics: [Average]
        - name: DatabaseConnections
          statistics: [Average]
        - name: FreeableMemory
          statistics: [Average]
        - name: VolumeBytesUsed
          statistics: [Average]
